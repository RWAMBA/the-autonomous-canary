# Required. Set a unique random token containing 32 to 512 bytes.
# Never place the real production value in this template.
CANARYGUARD_API_KEY=

# Intelligence provider configuration.
# MOCK is the safe local-development and public-CI default.
CANARYGUARD_INTELLIGENCE_PROVIDER=MOCK

# Required only when CANARYGUARD_INTELLIGENCE_PROVIDER=OPENAI.
# Store the real value in Render or another protected environment pool.
# Never commit, print, log, or expose the real value.
OPENAI_API_KEY=

# Bounded OpenAI request controls.
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4000

# GitHub App collection is disabled by default.
CANARYGUARD_GITHUB_PROVIDER=DISABLED

# Required only when CANARYGUARD_GITHUB_PROVIDER=APP.
# Store both values in a protected runtime environment.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Bounded GitHub REST API request timeout.
GITHUB_API_TIMEOUT_MS=10000

# Signed GitHub webhook ingestion is disabled by default.
CANARYGUARD_GITHUB_WEBHOOK_PROVIDER=DISABLED

# Required only when CANARYGUARD_GITHUB_WEBHOOK_PROVIDER=GITHUB.
# Store the real high-entropy value in a protected runtime environment.
GITHUB_WEBHOOK_SECRET=

# Per-process bounded replay-protection controls.
GITHUB_WEBHOOK_REPLAY_TTL_MS=600000
GITHUB_WEBHOOK_REPLAY_CAPACITY=10000

# Automated pull-request review and Check Run publishing is disabled by default.
# CHECKS also requires the GitHub App and webhook providers above.
CANARYGUARD_GITHUB_AUTOMATION_PROVIDER=DISABLED

# Per-process bounded asynchronous work controls.
GITHUB_AUTOMATION_QUEUE_CAPACITY=100
GITHUB_AUTOMATION_CONCURRENCY=1

# Application runtime configuration.
PORT=3000
RELEASE_CHANNEL=local
APP_VERSION=development
COMMIT_SHA=development
SIMULATED_FAILURE_EVERY=0

# Local Docker Compose controls.
CANARY_FAILURE_EVERY=0
ROUTING_MODE=canary
