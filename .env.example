# Required. Set a unique random token containing 32 to 512 bytes.
# Never place the real production value in this template.
CANARYGUARD_API_KEY=

# Intelligence provider configuration.
# MOCK is the safe local-development and public-CI default.
CANARYGUARD_INTELLIGENCE_PROVIDER=MOCK

# Required only when CANARYGUARD_INTELLIGENCE_PROVIDER=OPENAI.
# Store the real value in Render or another protected environment pool.
# Never commit, print, log, or expose the real value.
OPENAI_API_KEY=

# Bounded OpenAI request controls.
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=4000

# Application runtime configuration.
PORT=3000
RELEASE_CHANNEL=local
APP_VERSION=development
COMMIT_SHA=development
SIMULATED_FAILURE_EVERY=0

# Local Docker Compose controls.
CANARY_FAILURE_EVERY=0
ROUTING_MODE=canary
