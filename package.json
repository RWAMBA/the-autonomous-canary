{
  "name": "the-autonomous-canary",
  "version": "0.1.0",
  "private": true,
  "description": "A portfolio project demonstrating CI/CD, Docker, and automated canary deployments.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "tsx --test test/*.test.ts test/*/*.test.ts",
    "verify:routing": "tsx scripts/verify-routing.ts",
    "evaluate:canary": "tsx scripts/evaluate-canary.ts",
    "build": "tsc --project tsconfig.json",
    "db:migrate": "npm run build && node --enable-source-maps dist/migrate-database.js",
    "start": "node --enable-source-maps dist/server.js",
    "routing:apply": "tsx scripts/apply-routing.ts",
    "rollout:canary": "tsx scripts/run-canary-rollout.ts",
    "deployment:discover:render": "tsx scripts/discover-render-deployment.ts",
    "tenant:provision": "tsx scripts/provision-tenant.ts"
  },
  "devDependencies": {
    "@axe-core/cli": "4.13.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "chromedriver@152.0.3": false,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "chromedriver": "152.0.3"
  },
  "dependencies": {
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
