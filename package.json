{
  "name": "the-autonomous-canary",
  "version": "0.1.0",
  "private": true,
  "description": "A portfolio project demonstrating CI/CD, Docker, and automated canary deployments.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "verify:routing": "tsx scripts/verify-routing.ts",
    "evaluate:canary": "tsx scripts/evaluate-canary.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --enable-source-maps dist/server.js",
    "routing:apply": "tsx scripts/apply-routing.ts",
    "rollout:canary": "tsx scripts/run-canary-rollout.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
